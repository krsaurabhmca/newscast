[{"setting_key":"about_page_content","setting_value":"<p><strong>\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902\u2026<\/strong><\/p><p><br><\/p><p>\u201c\u092a\u0902\u091a\u093e\u092f\u0924 \u0935\u0949\u092f\u0938\u201d \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0932\u094b\u0915\u0924\u093e\u0902\u0924\u094d\u0930\u093f\u0915 \u092e\u0942\u0932\u094d\u092f\u094b\u0902 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0905\u092a\u0928\u0947 \u092a\u093e\u0920\u0915\u094b\u0902 \u0915\u094b \u0938\u0939\u0940 \u0935 \u0938\u091f\u0940\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0926\u0947\u0928\u093e \u0939\u0948, \u091c\u093f\u0938\u0938\u0947 \u0935\u0947 \u0932\u094b\u0915\u0924\u0902\u0924\u094d\u0930 \u0915\u0940 \u092e\u091c\u092c\u0942\u0924\u0940 \u092e\u0947\u0902 \u090f\u0915 \u0938\u091a\u0947\u0924 \u0914\u0930 \u0938\u0915\u094d\u0937\u092e \u0928\u093e\u0917\u0930\u093f\u0915 \u0915\u0940 \u092d\u0942\u092e\u093f\u0915\u093e \u0915\u093e \u0928\u093f\u0930\u094d\u0935\u0939\u0928 \u0915\u0930 \u0938\u0915\u0947\u0902\u0964 \u0939\u092e\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0938\u094b\u091a \u201c\u0924\u0925\u094d\u092f \u0939\u0940 \u0938\u0924\u094d\u092f \u0939\u0948\u201d \u0915\u0940 \u0939\u0948, \u0907\u0938\u0938\u0947 \u0939\u092e \u0938\u092e\u091d\u094c\u0924\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964<\/p><p>panchayatvoice.in \u0935\u0947\u092c \u092a\u094b\u0930\u094d\u091f\u0932 \u201c\u092a\u0902\u091a\u093e\u092f\u0924 \u0935\u0949\u092f\u0938\u201d \u0928\u093e\u092e\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0939\u093f\u0928\u094d\u0926\u0940 \u092e\u093e\u0938\u093f\u0915 \u0938\u092e\u093e\u091a\u093e\u0930 \u092a\u0924\u094d\u0930\u093f\u0915\u093e \u0915\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0939\u0948, \u091c\u094b \u0926\u0947\u0936 \u0915\u0947 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u0914\u0930 \u0936\u0939\u0930\u0940 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0935\u094d\u092f\u093e\u092a\u094d\u0924 \u091a\u0941\u0928\u094c\u0924\u093f\u092f\u094b\u0902 \u0915\u0947 \u0928\u093f\u0930\u093e\u0915\u0930\u0923 \u090f\u0935\u0902 \u092c\u0947\u0939\u0924\u0930\u0940 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e\u0913\u0902 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u091c\u0928 \u0938\u0930\u094b\u0915\u093e\u0930 \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u0928 28 \u092e\u093e\u0930\u094d\u091a 2026 \u0915\u094b \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u0940 \u0930\u093e\u091c\u0927\u093e\u0928\u0940 \u0932\u0916\u0928\u090a \u0938\u0947 \u0936\u094d\u0930\u0940 \u0938\u0902\u0935\u0924 2083 \u0936\u0915 1948 \u091a\u0948\u0924\u094d\u0930 \u092e\u093e\u0938\u0947 \u0936\u0941\u0915\u094d\u0932 \u092a\u0915\u094d\u0937\u0947 \u0926\u0936\u0902\u092f\u093e\u092e \u0924\u093f\u0925\u094c \u0936\u0928\u093f\u0935\u093e\u0938\u0930\u0947 \u092a\u0941\u0937\u094d\u092f \u0928\u0936\u0924\u094d\u0930 \u0938\u0915\u0930\u094d\u092e\u093e \u092f\u094b\u0917 \u092e\u0947\u0902 \u0938\u0902\u092a\u0928\u094d\u0928 \u0939\u0941\u0906\u0964&nbsp;<\/p><p>\u0939\u092e\u093e\u0930\u093e \u0915\u094b\u0930 \u0935\u0948\u0932\u094d\u092f\u0942 \u201c\u092a\u0902\u091a\u093e\u092f\u0924 \u0938\u0947 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u201d \u0915\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0917\u093e\u0902\u0935 \u0915\u0940 \u092a\u0902\u091a\u093e\u092f\u0924 \u0938\u0947 \u0932\u0947\u0915\u0930 \u0926\u0947\u0936 \u0915\u0940 \u092a\u0902\u091a\u093e\u092f\u0924 \u0924\u0915 \u0915\u0940 \u092c\u093e\u0924 \u0939\u094b\u0917\u0940\u0964 \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u092e\u0938\u093e\u092e\u092f\u093f\u0915, \u0930\u093e\u091c\u0928\u0940\u0924\u093f\u0915, \u091c\u094d\u091e\u093e\u0928-\u0935\u093f\u091c\u094d\u091e\u093e\u0928, \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e, \u0915\u0932\u093e, \u0938\u093e\u0939\u093f\u0924\u094d\u092f, \u0915\u093e\u0930\u094b\u092c\u093e\u0930 \u0935 \u0916\u0947\u0932 \u0938\u0939\u093f\u0924 \u0905\u0928\u094d\u092f \u0935\u093f\u0937\u092f\u094b\u0902 \u0915\u093e \u0938\u092e\u093e\u0935\u0947\u0936 \u0939\u094b\u0917\u093e\u0964 \u0939\u092e\u093e\u0930\u0940 \u0915\u094b\u0936\u093f\u0936 \u0939\u094b\u0917\u0940 \u0915\u093f \u0939\u092e\u093e\u0930\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0935 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0916\u092c\u0930\u0947\u0902, \u0911\u0921\u093f\u092f\u094b \u0914\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u091c\u0928-\u091c\u0928 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u0947\u0902\u0964<\/p><p><br><\/p><p>\u0907\u0938 \u092e\u0902\u091a \u092a\u0930 \u0916\u092c\u0930\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0932\u0947\u0916, \u0938\u094d\u091f\u094b\u0930\u0940, \u0935\u093f\u091a\u093e\u0930, \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923, \u092b\u0940\u091a\u0930, \u0938\u0902\u092a\u093e\u0926\u0915\u0940\u092f \u0924\u0925\u093e \u0905\u0928\u094d\u092f \u091c\u0928 \u0938\u0930\u094b\u0915\u093e\u0930 \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u0940 \u091c\u093e\u090f\u0917\u0940, \u0924\u093e\u0915\u093f \u0938\u092e\u093e\u091c \u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u0939\u0932\u0941\u0913\u0902 \u0915\u094b \u0938\u092e\u0917\u094d\u0930 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u093e\u0920\u0915\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964 \u0939\u092e \u0916\u092c\u0930\u094b\u0902 \u0915\u094b \u0932\u0947\u0915\u0930 \u090f\u0915 \u0935\u093f\u0936\u0947\u0937 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0938\u0942\u091a\u0928\u093e\u0913\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0916\u092c\u0930 \u0915\u094b \u0938\u0928\u0938\u0928\u0940\u0916\u0947\u091c \u092c\u0928\u093e\u0928\u093e \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0905\u092a\u093f\u0924\u0941 \u0916\u092c\u0930\u094b\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u0939\u0932\u0941\u0913\u0902 \u0915\u094b \u091f\u091f\u094b\u0932\u0924\u0947 \u0939\u0941\u090f \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u094b \u0938\u0902\u0915\u0932\u093f\u0924 \u0915\u0930 \u0938\u0939\u0940, \u0938\u091f\u0940\u0915 \u0914\u0930 \u092a\u0941\u0916\u094d\u0924\u093e \u0938\u092e\u093e\u091a\u093e\u0930 \u092a\u093e\u0920\u0915\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a\u093e\u0928\u093e \u0939\u092e\u093e\u0930\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0939\u0948\u0964<\/p><p><br><\/p><p>\u0939\u092e\u093e\u0930\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0938\u094b\u091a \u0939\u0940 \u201c\u0924\u0925\u094d\u092f \u0939\u0940 \u0938\u0924\u094d\u092f \u0939\u0948\u201d \u0915\u0940 \u0939\u0948\u0964 \u0907\u0938\u0938\u0947 \u0939\u092e \u0938\u092e\u091d\u094c\u0924\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u092d\u0932\u0947 \u0939\u0940 \u0938\u0939\u0940 \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0947\u0964 \u0915\u092d\u0940-\u0915\u092d\u0940 \u0939\u0921\u093c\u092c\u0921\u093c\u0940 \u092e\u0947\u0902 \u0910\u0938\u0940 \u0916\u092c\u0930\u0947\u0902 \u0935\u093e\u092f\u0930\u0932 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0902, \u091c\u093f\u0928\u0915\u093e \u0938\u0924\u094d\u092f \u0914\u0930 \u0924\u0925\u094d\u092f \u0938\u0947 \u0915\u094b\u0908 \u0938\u0930\u094b\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u0932\u0947\u0915\u093f\u0928 \u0935\u093e\u092f\u0930\u0932 \u0916\u092c\u0930\u094b\u0902 \u0915\u0947 \u0907\u0938 \u0926\u094c\u0930 \u092e\u0947\u0902 \u0939\u092e \u0914\u0930 \u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0938\u0924\u094d\u092f \u0915\u093e \u0936\u094b\u0927\u0928 \u0915\u0930 \u0924\u0925\u094d\u092f \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0938\u093f\u0930\u094d\u092b \u0938\u091a \u0915\u094b \u0932\u093e\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0930\u0916\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0938\u0902\u092a\u093e\u0926\u0915\u0940\u092f \u091f\u0940\u092e, \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e, \u0935\u093f\u091a\u093e\u0930\u0915\u094b\u0902 \u0915\u0940 \u0928\u091c\u0930 \u0926\u0947\u0936, \u092a\u094d\u0930\u0926\u0947\u0936, \u0936\u0939\u0930, \u0928\u0917\u0930, \u0917\u093e\u0902\u0935, \u0917\u0932\u093f\u092f\u093e\u0930\u0947, \u0927\u0930\u094d\u092e, \u0930\u093e\u091c\u0928\u0940\u0924\u093f, \u0936\u093e\u0938\u0928-\u0938\u0924\u094d\u0924\u093e \u0915\u0947 \u0917\u0932\u093f\u092f\u093e\u0930\u094b\u0902 \u0915\u0947 \u0939\u0930 \u0909\u0938 \u0916\u092c\u0930 \u092a\u0930 \u0930\u0939\u0924\u0940 \u0939\u0948, \u091c\u094b \u0906\u092a \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964<\/p><p><br><\/p><p>\u0916\u092c\u0930 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u092e \u0938\u092e\u093e\u091c \u0915\u0947 \u0938\u092d\u0940 \u0924\u092c\u0915\u094b\u0902 \u0915\u093e \u0916\u094d\u092f\u093e\u0932 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0940 \u0928\u093f\u091c\u0924\u093e \u0915\u093e \u092d\u0940 \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u093f\u0916\u0924\u0947 \u0938\u092e\u092f \u0939\u092e \u0905\u0926\u093e\u0932\u0924\u0940 \u0906\u0926\u0947\u0936\u094b\u0902 \u0914\u0930 \u092a\u094d\u0930\u0947\u0938 \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0916\u092c\u0930 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u092e \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u0938\u0939\u0940 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u0938\u0939\u093e\u0930\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u094d\u092a\u0937\u094d\u091f\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0932\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0906\u0915\u094d\u0937\u0947\u092a \u0935\u093e\u0932\u0940 \u092d\u093e\u0937\u093e \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0905\u0925\u0935\u093e \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u0941\u0926\u093e\u092f, \u0938\u0902\u0938\u094d\u0925\u093e, \u091c\u093e\u0924\u093f, \u0927\u0930\u094d\u092e, \u0917\u0941\u091f \u092f\u093e \u0935\u093f\u091a\u093e\u0930\u0927\u093e\u0930\u093e \u0915\u094b \u0909\u0915\u0938\u093e\u0928\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0909\u0938\u0947 \u0938\u0939\u0940 \u0926\u093f\u0936\u093e \u0914\u0930 \u0930\u093e\u0939 \u0926\u093f\u0916\u093e\u0928\u093e \u0939\u0948\u0964<\/p><p><br><\/p><p>\u0939\u092e\u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0915\u094b\u0908 \u0938\u093e\u0925\u0940 \u092f\u0926\u093f \u0936\u0930\u094d\u0924 \u0914\u0930 \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u0924\u094b \u0909\u0938\u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u201c\u092a\u0902\u091a\u093e\u092f\u0924 \u0935\u0949\u092f\u0938\u201d \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0938\u0942\u091a\u0928\u093e \u0915\u0947 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092f\u0939\u093e\u0902 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0924\u092d\u0940 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u091c\u092c \u0938\u0902\u092a\u093e\u0926\u0915\u0940\u092f \u091f\u0940\u092e \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0905\u0928\u0941\u092e\u0924\u093f \u092f\u093e \u0938\u0939\u092e\u0924\u093f \u0932\u0940 \u0917\u0908 \u0939\u094b\u0964&nbsp;\u0906\u092a \u091c\u094b \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0939\u092e\u0947\u0902 \u092a\u094d\u0930\u0915\u093e\u0936\u0928 \u0914\u0930 \u092a\u094d\u0930\u0938\u093e\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092d\u0947\u091c\u0947\u0902\u0917\u0947, \u0909\u0938\u0915\u0940 \u092a\u0939\u0932\u0940 \u0936\u0930\u094d\u0924 \u0939\u0948 \u0915\u093f \u0935\u0939 \u0905\u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u094b \u0924\u0925\u093e \u0924\u0925\u094d\u092f\u092a\u0930\u0915 \u0939\u094b\u0964<\/p><p><br><\/p><p>\u0939\u092e\u093e\u0930\u0940 \u0915\u094b\u0936\u093f\u0936 \u0938\u092e\u093e\u091c \u092e\u0947\u0902 \u092a\u0924\u094d\u0930\u0915\u093e\u0930\u093f\u0924\u093e \u0915\u094b \u092e\u091c\u092c\u0942\u0924\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0921\u093c\u093e \u0915\u0930\u0928\u0947 \u092a\u0930 \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u093e \u091c\u094b\u0930 \u0939\u0948 \u0915\u093f \u0939\u093f\u0928\u094d\u0926\u0940 \u092a\u0924\u094d\u0930\u0915\u093e\u0930\u093f\u0924\u093e \u092e\u0947\u0902 \u201c\u0924\u0925\u094d\u092f \u0939\u0940 \u0938\u0924\u094d\u092f \u0939\u0948\u201d \u0915\u093e \u092e\u0942\u0932\u094d\u092f \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u094b\u0964<\/p><p>\u0938\u093e\u0926\u0930\u0964<\/p><p><br><\/p><p><strong>Panchayatvoice.up@gmail.com<\/strong><\/p><p><strong>Mobile Number \u2013 9876917688<\/strong><\/p>"},{"setting_key":"about_page_image","setting_value":"about_cover_6a3bb243555ea_1782297155.webp"},{"setting_key":"about_page_title","setting_value":"About Panchayat Voice"},{"setting_key":"address","setting_value":"UP, Bihar, Delhi"},{"setting_key":"apni_baat_label","setting_value":"Apni Baat"},{"setting_key":"bing_site_verify","setting_value":""},{"setting_key":"breaking_news_enabled","setting_value":"yes"},{"setting_key":"collapse_sidebar","setting_value":"no"},{"setting_key":"comments_enabled","setting_value":"no"},{"setting_key":"comments_moderation_enabled","setting_value":"yes"},{"setting_key":"contact_email","setting_value":"report@panchayatvoice.in"},{"setting_key":"contact_phone","setting_value":"9876917688"},{"setting_key":"copyright_text","setting_value":""},{"setting_key":"db_version","setting_value":"10"},{"setting_key":"ebook_magazin